MNEMONIC_FILE=~/.liquidium-pipeline/wallets/key
IC_URL=https://ic0.app
EVM_RPC_URL=
MEXC_DEFAULT_ROUTE_CHAIN_ID=1

CEX_LIST= #mexc
CEX_MEXC_API_KEY=
CEX_MEXC_API_SECRET=
# Kraken is opt-in: add `kraken` to ENABLED_SWAP_VENUES before setting these.
CEX_KRAKEN_API_KEY=
CEX_KRAKEN_API_SECRET=

BRIDGE_CKETH_MINTER_CANISTER=sv3dd-oaaaa-aaaar-qacoa-cai

MAX_ALLOWED_DEX_SLIPPAGE=200     #2% max slippage
MAX_ALLOWED_CEX_SLIPPAGE_BPS=200 #2% max slippage
BAD_DEBT_COLLATERAL_SLIPPAGE_BPS=500 #5% bad-debt-only min collateral haircut

# Ordered venues eligible for new swap plans
ENABLED_SWAP_VENUES=icpswap,mexc
# TEST ONLY: force this USD amount to ICPSwap and route the remainder to MEXC.
# Below $10 the forced leg's quote is NOT checked against the oracle (its ledger
# fees outweigh the whole discount budget at that size); the remainder still is.
ICPSWAP_TEST_ALLOCATION_USD=1
ICPSWAP_DUST_FALLBACK_MAX_PRICE_IMPACT_BPS=150 # 1.5%, only when the MEXC remainder is below minimum

# CEX execution tunables
CEX_MIN_EXEC_USD=8 # skip slices below this USD notional as dust
CEX_SLICE_TARGET_RATIO=0.7 # target slice impact ratio of MAX_ALLOWED_CEX_SLIPPAGE_BPS
CEX_BUY_TRUNCATION_TRIGGER_RATIO=0.25 # trigger inverse fallback when truncation ratio >= this value
CEX_BUY_INVERSE_OVERSPEND_BPS=10 # max allowed overspend (bps) in inverse/base buy fallback
CEX_BUY_INVERSE_MAX_RETRIES=1 # max inverse/base fallback attempts per leg
CEX_BUY_INVERSE_ENABLED=true # enable adaptive buy fallback after quote truncation
CEX_RETRY_BASE_SECS=5 # base backoff for retryable CEX errors
CEX_RETRY_MAX_SECS=120 # max backoff cap for retryable CEX errors
MULTI_VENUE_MIN_NET_EDGE_BPS=150 # minimum conservative edge required for any venue plan
MULTI_VENUE_MAX_ORACLE_DISCOUNT_BPS=250 # reject any venue quote >2.5% below oracle-implied output
MULTI_VENUE_ORACLE_SNAPSHOT_MAX_AGE_SECS=300 # how long a recorded price may stand in for a live oracle read
CEX_DELAY_BUFFER_BPS=75 # latency risk haircut applied to projected edge
CEX_ROUTE_FEE_BPS=25 # estimated route fee haircut (bps)
# Optional CSV market universe for hop discovery
CEX_MEXC_AVAILABLE_PAIRS=CKBTC_BTC,BTC_USDC,BTC_USDT,USDC_USDT,CKUSDT_USDT,ICP_USDT,ICP_USDC,ETH_USDT
CEX_MEXC_MAX_HOPS=2 # max intermediate hops for configured-pair route search (0 disables hop fallback)
# Optional canonical Kraken markets (`XBT` is normalized to `BTC` internally)
CEX_KRAKEN_AVAILABLE_PAIRS=BTC_USD,ETH_USD,USDC_USD
CEX_KRAKEN_MAX_HOPS=2 # max intermediate hops; Kraken remains unavailable outside this allowlist


LENDING_CANISTER=nja4y-2yaaa-aaaae-qddxa-cai
KOND_SWAP_BACKEND=2ipq2-uqaaa-aaaar-qailq-cai

# Supported assets
DEBT_ASSETS=icp:mxzaz-hqaaa-aaaar-qaada-cai:ckBTC,icp:cngnf-vqaaa-aaaar-qag4q-cai:ckUSDT,icp:xevnm-gaaaa-aaaar-qafnq-cai:ckUSDC,icp:ss2fx-dyaaa-aaaar-qacoq-cai:ckETH,icp:ryjl3-tyaaa-aaaaa-aaaba-cai:ICP
COLLATERAL_ASSETS=icp:mxzaz-hqaaa-aaaar-qaada-cai:ckBTC,icp:cngnf-vqaaa-aaaar-qag4q-cai:ckUSDT,icp:xevnm-gaaaa-aaaar-qafnq-cai:ckUSDC,icp:ss2fx-dyaaa-aaaar-qacoq-cai:ckETH,icp:ryjl3-tyaaa-aaaaa-aaaba-cai:ICP

OPPORTUNITY_ACCOUNT_FILTER=h64ya-zt56r-44pvj-pjay2-j47ik-gv222-iw4mq-3wrll-yho5m-kmth4-kae

WATCHDOG_WEBHOOK=
SLACK_WEBHOOK_URL=
BOT_NAME=
LOW_BALANCE_THRESHOLDS=
BALANCE_CHECK_EXCLUDE=
BUY_BAD_DEBT=true
DB_PATH=~/wal.db
LIQUIDATIONS_DB_PATH=~/liquidations.db
EXPORT_PATH=~/executions.csv
# OpenTelemetry - Local stack: docker-compose up -d
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces
OTEL_EXPORTER_OTLP_LOGS_ENDPOINT=http://localhost:3100/otlp/v1/logs
OTEL_SERVICE_NAME=liquidium-pipeline
